{
  "name": "Survival Reimagined",
  "author": "Insane96",
  "exportDir": "../../Export",
  "clientOverrides": ["config", "datapacks", "resourcepacks"],
  "serverFolders": ["config", "datapacks", "defaultconfigs", "mods", "optional_datapacks", "scripts"],
  "exclude": ["*.toml.bak", "config/spark/tmp*", "config/spark/activity.json"],
  "clientModsFile": "clientmods.txt",
