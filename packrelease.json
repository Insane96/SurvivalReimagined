    "releaseType": "release",
    "tokenVariable": "CF_API_TOKEN"
  },
  "bisect": {
    "serverId": "95b04099",
    "panelUrl": "https://games.bisecthosting.com",
    "apiTokenVariable": "BISECT_HOSTING_API_TOKEN",
    "sftpPasswordVariable": "BISECT_HOSTING_SFTP_PASSWORD",
    "backupFolders": ["world"],
    "backupDownloadDir": "../../Export/ServerBackups",
    "keepArchives": 3,
    "warningSeconds": 60
  }
